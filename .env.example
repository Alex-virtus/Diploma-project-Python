# Django settings
SECRET_KEY='Secret key for security'

# Database PostgreSQL settings
DB_ENGINE=django.db.backends.postgresql # Database engine
DB_NAME=Database name
DB_USER=Database username
DB_PASSWORD=Database password
DB_HOST=Database host # localhost
DB_PORT=Database port # 5432

# Outgoing email (SMTP) settings
# gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
# An app password created in the email security settings.
# Do not enter your regular email password here.
EMAIL_HOST_PASSWORD='your-app-password'
DEFAULT_FROM_EMAIL=your-email@gmail.com
# Email address receiving order invoices
ORDER_ADMIN_EMAIL=admin@gmail.com

